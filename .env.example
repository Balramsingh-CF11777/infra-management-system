VITE_APP_ENV=uat
# Frappe server (separate from the React app). UAT:
VITE_FRAPPE_API_URL=https://uatimcore26.chola.murugappa.com
# true: `npm run dev` serves http://localhost:5174 and proxies /api, /files, /private to VITE_FRAPPE_API_URL.
# false: the browser calls VITE_FRAPPE_API_URL directly (needs allow_cors on the Frappe site).
VITE_DEV_PROXY=true
